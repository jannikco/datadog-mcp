{
  "openapi": "3.1.0",
  "info": {
    "title": "Datadog selected operations",
    "version": "0.2.0",
    "description": "Reviewed local connector bindings for manual API import. No provider credentials are included; authentication and hosted execution require separate configuration and tests."
  },
  "servers": [
    {
      "url": "https://{DATADOG_API_HOST}",
      "variables": {
        "DATADOG_API_HOST": {
          "default": "your-account.example.com",
          "description": "Replace with your own authorized provider account value."
        }
      }
    }
  ],
  "paths": {
    "/api/v1/validate": {
      "get": {
        "operationId": "validate_api_key",
        "summary": "Validate api key.",
        "parameters": [],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      }
    },
    "/api/v1/monitor": {
      "get": {
        "operationId": "list_monitors",
        "summary": "List monitors.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      }
    },
    "/api/v1/events": {
      "post": {
        "operationId": "create_event",
        "summary": "Create event.",
        "parameters": [],
        "x-pipmcp-read-only": false,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "description": "Value"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "description": "Value"
                  },
                  "alert_type": {
                    "type": "string",
                    "enum": [
                      "error",
                      "warning",
                      "info",
                      "success"
                    ]
                  }
                },
                "required": [
                  "title",
                  "text"
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "providerAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "DD-API-KEY"
      },
      "header_DD_APPLICATION_KEY": {
        "type": "apiKey",
        "in": "header",
        "name": "DD-APPLICATION-KEY"
      }
    }
  },
  "security": [
    {
      "providerAuth": [],
      "header_DD_APPLICATION_KEY": []
    }
  ]
}
